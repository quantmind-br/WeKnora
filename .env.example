# =====================================================================
# WeKnora environment variable configuration example
# ---------------------------------------------------------------------
# Usage instructions:
# Copy this file to .env: cp .env.example .env
# Replace all placeholders with actual values (especially items marked ⚠️ Required)
# Make sure .env is not committed to version control
#
# Configuration injection mechanism:
# - The app service reads all variables in this file via env_file: .env;
# - docreader / mcp / frontend / odl-hybrid services have no env_file and only consume
# variables explicitly listed in their own environment section (see docker-compose.yml).
#
# Group order:
# A. Deployment basics    Image, runtime, network
# B. Data & storage       Database, Redis, file storage, object storage
# C. Retrieval & graph    Vector store, knowledge graph
# D. Models               LLM/VLM/Ollama, built-in models
# E. Document parsing     Docreader, task timeout
# F. Auth & tenant isolation  JWT/AES, registration, RBAC, OIDC
# G. Agent & sandbox      Sandbox, Skills, Agent timeout
# H. Optional integrations   Web search, MCP Server
# I. Observability        Langfuse
# J. Security & tuning    SSRF, proxy, concurrency
# =====================================================================


# #####################################################################
# A. Deployment basics
# #####################################################################

# ========== A1. Image version & build ==========
# WeKnora image version tag: latest (stable) / main (latest dev). When upgrading, set the version to the target release (e.g. 0.7.0) and run docker compose pull to fetch the corresponding image.
WEKNORA_VERSION=latest
# Alpine apk mirror (used to build the app image; leave empty for the default mirror; in mainland China you can set mirrors.tencent.com to speed things up).
APK_MIRROR_ARG=mirrors.tencent.com
# apt mirror used when building the docreader image (leave empty for the default mirror).
# APT_MIRROR=

# ========== A2. Runtime basics ==========
# gin run mode: debug (development, verbose logs + Swagger) / release (production, disables Swagger).
GIN_MODE=release
# Log level: debug / info / warn / error / fatal, defaults to debug.
# LOG_LEVEL=debug
# Log file path (leave empty to output to stdout only); when LLM_DEBUG_LOG is enabled, llm_debug.log is written to the same directory.
# LOG_PATH=
# Custom log format template (leave empty to use the built-in default format).
# LOG_FORMAT=
# LLM debug log: writes the full request/response of every LLM call to a dedicated file, for troubleshooting context issues.
# Allowed values: true (write llm_debug.log to the same directory as LOG_PATH) / false or empty (disabled) / a specific file path.
# LLM_DEBUG_LOG=true
# Timezone, defaults to Asia/Shanghai. Affects system time display and log timestamps.
# Common values: Asia/Shanghai, Asia/Tokyo, America/New_York, Europe/London, UTC.
TZ=Asia/Shanghai
# System default language (BCP-47), used as the fallback for the {{language}} placeholder in prompts.
# Priority: Accept-Language request header > this variable > built-in default (en-US).
# WEKNORA_LANGUAGE=en-US
# Automatically run database migrations on startup; set to false to disable (enabled by default).
AUTO_MIGRATE=true
# Automatically recover a dirty migration state (default true).
AUTO_RECOVER_DIRTY=true
# On startup, automatically promote the user with the specified email to system admin (idempotent; only ever PROMOTEs, never DEMOTEs).
# Intended for the first bootstrap of docker-compose/k8s deployments; subsequent privilege grants/revocations should go through the SystemAdmin management page.
# WEKNORA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=

# ========== A3. Network and External Addresses ==========
# App service hostname, default app (Docker internal service name); for a remote backend, set the remote address.
APP_HOST=app
# App service host machine mapped port, default 8080 (affects host access only, not inter-container communication).
APP_PORT=8080
# Target port NGINX proxies to on the backend, default 8080 (port the App container listens on internally).
# Keep the default for local deployments; for remote deployments, set to the remote App service's actual port.
# APP_BACKEND_PORT=8080
# Protocol NGINX uses to proxy to the backend, default http; set to https if the remote backend uses HTTPS.
# APP_SCHEME=http
# Frontend service port, default 80.
FRONTEND_PORT=80
# Docreader address (used by app to connect to docreader).
DOCREADER_ADDR=docreader:50051
# Docreader connection method: grpc / http / https.
DOCREADER_TRANSPORT=grpc
# App external access address (affects image/file outbound links in IM channels).
# Set to the URL where the WeKnora instance is reachable from the IM platform/client's public network, e.g. https://weknora.example.com.
# For IM to display knowledge base images, the IM side needs to fetch the image via a publicly reachable http URL. Choose one of:
# (A) The storage backend itself is publicly reachable (use a public endpoint for object storage, or set MINIO_ENDPOINT to a public host);
# in this case resource:// falls back to the backend's pre-signed URL, and this variable is not needed.
# (B) Set this variable, and resource:// images are rewritten to <APP_EXTERNAL_URL>/r/<token> routed through WeKnora (requires nginx to proxy /r/).
# For the default MinIO deployment (minio:9000 is internal), option (B) is simplest; the local backend can only use (B).
# Internal IPs and localhost are unreachable from IM platforms like Feishu/WeCom/Slack; for local development, use ngrok/cloudflared/frp.
# APP_EXTERNAL_URL=
# Frontend external origin, used for absolute URLs like invitation links (leave blank for host-relative).
# FRONTEND_BASE_URL=
# Default form of file references in API responses: handle (default) / public.
# handle — returns the internal resource://<handle>; the client must call the authenticated /files proxy again to fetch the image.
# public — returns a directly loadable http(s) link; third-party apps can render it as-is with no extra request.
# A single request can override this variable with ?resource_urls=handle|public; see the README "API Reference" for override scope.
# public relies on APP_EXTERNAL_URL above (or the storage backend itself being publicly reachable) to generate outbound links;
# when it cannot be generated, the reference stays as resource:// as-is, and the client can still fall back to /files.
# Note: public issues a time-limited (WeKnora 2 hours / MinIO 24 hours) anonymously readable link for each referenced file.
# Anonymous embed channels and knowledge-base-scoped API Keys are unaffected by this variable and always return handle.
# It is recommended to also configure SYSTEM_AES_KEY, to reuse grant rows, keep direct link URLs stable, and reduce write load on read endpoints.
# RESOURCE_URL_MODE=handle
# Externally exposed MCP Server port (default 8082).
# MCP_PORT=8082


# #####################################################################
# B. Data and Storage
# #####################################################################

# ========== B1. Database ⚠️ Required ==========
# Primary database type: postgres / mysql / sqlite.
DB_DRIVER=postgres
# Database host address.
DB_HOST=postgres
# Database port.
DB_PORT=5432
# Database username.
DB_USER=postgres
# Database password.
DB_PASSWORD=postgres123!@#
# Database name.
DB_NAME=WeKnora
# Used with the SQLite driver (DB_DRIVER=sqlite); ignored for postgres/mysql.
# DB_PATH=./data/weknora.db

# ========== B2. Redis / Stream Processing / Asynq Queue ==========
# --- Stream processing backend and Redis connection ---
# Stream processing backend: memory / redis. In redis mode, the Asynq task queue also depends on this Redis.
STREAM_MANAGER_TYPE=redis
# Redis address (leave empty to disable Redis; Lite mode uses memory).
REDIS_ADDR=redis:6379
# Redis username (Redis 6.0+ ACL, optional).
# REDIS_USERNAME=
# Redis password, leave empty if not set.
REDIS_PASSWORD=redis123!@#
# Redis database index, default 0.
REDIS_DB=0
# Redis key prefix, used for namespace isolation.
REDIS_PREFIX=stream:
# Redis channel namespace suffix (for isolation when multiple deployments share the same Redis).
# WEKNORA_REDIS_NAMESPACE=
# Asynq client Redis read/write timeout (milliseconds, default 500; write can be extended to 1000).
# WEKNORA_REDIS_OP_TIMEOUT_MS=500

# --- Redis TLS (encrypted transport for managed Redis, e.g. AWS ElastiCache; disabled by default) ---
# Whether to enable TLS.
# REDIS_USE_TLS=false
# Server name for TLS certificate validation and SNI (useful when the address is an IP).
# REDIS_TLS_SERVER_NAME=
# Skip server certificate validation. Insecure — for dev/self-signed certificates only, disable in production.
# REDIS_TLS_INSECURE_SKIP_VERIFY=false

# --- Asynq worker concurrency ---
# Each pool is an independent asynq.Server, hard-isolated; leave empty or <1 to use the code default. The value is "minimum guaranteed concurrency per instance" — accumulates across replicas in multi-replica deployments. Can also be adjusted at runtime via system settings (asynq.*_concurrency) without restart. Format: variable = default value — queues consumed / description
# default + chat_attachment (main document parsing pipeline; chat_attachment has higher weight to avoid being crowded out by bulk imports)
# WEKNORA_ASYNQ_CORE_CONCURRENCY=8
# postprocess (post-parsing knowledge base processing/fan-out; a separate pool avoids queuing behind long-running DocReader tasks, needs low latency)
# WEKNORA_ASYNQ_POSTPROCESS_CONCURRENCY=2
# summary / multimodal / graph / question (summary, image multimodal, graph chunk extraction, question generation; LLM/VLM-heavy, tune by provider budget)
# WEKNORA_ASYNQ_ENRICHMENT_CONCURRENCY=12
# sync + low (data source sync, FAQ import, KB clone/delete, bulk re-parsing, knowledge move; long-running, does not borrow from shared)
# WEKNORA_ASYNQ_MAINTENANCE_CONCURRENCY=4
# Elastic pool, can borrow from CORE/ENRICHMENT queues (atomic dequeue-safe); does not consume POSTPROCESS/MAINTENANCE
# WEKNORA_ASYNQ_SHARED_CONCURRENCY=6
# Dedicated pool for Wiki generation (LLM-bound, tune by provider concurrency budget)
# WEKNORA_WIKI_ASYNQ_CONCURRENCY=8
# Per-model concurrency cap for background tasks (0/negative disables; interactive chat is not subject to this limit)
# WEKNORA_MODEL_MAX_CONCURRENCY=32

# ========== B3. File Storage (General) ==========
# File storage type: local / minio / cos / tos / s3 / obs / oss / dummy.
STORAGE_TYPE=local
# Whitelist of storage types users are allowed to use (comma-separated; leave empty to allow all).
# STORAGE_ALLOW_LIST=local,minio,cos,tos,s3,obs,oss
# Local storage root directory (used when STORAGE_TYPE=local).
LOCAL_STORAGE_BASE_DIR=/data/files
# Local storage path prefix (for legacy backfill; usually leave empty).
# LOCAL_STORAGE_PATH_PREFIX=
# Unified file size limit (MB, default 50). Affects single-file upload, docreader gRPC messages, frontend Nginx request body, and browser client validation. This is a deployment-time setting: read once at startup by the Go/Nginx/docreader/browser layers; changes don't take effect at runtime and require restarting all four layers.
# MAX_FILE_SIZE_MB=50

# ========== B4. Object Storage Provider (choose one based on STORAGE_TYPE) ==========
# ----- MinIO（STORAGE_TYPE=minio）-----
# MinIO endpoint (host:port). For IM channels, must be a host publicly reachable by the IM platform (cannot use minio:9000).
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY_ID=your_minio_access_key
# MINIO_SECRET_ACCESS_KEY=your_minio_secret_key
# MINIO_BUCKET_NAME=your_minio_bucket_name
# MINIO_PATH_PREFIX=
# MINIO_USE_SSL=false
# MinIO port (for compose mapping).
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# ----- Tencent Cloud COS (STORAGE_TYPE=cos) -----
# COS_SECRET_ID=your_cos_secret_id
# COS_SECRET_KEY=your_cos_secret_key
# COS_REGION=ap-guangzhou
# COS_BUCKET_NAME=your_cos_bucket_name
# COS_APP_ID=your_cos_app_id
# COS_PATH_PREFIX=your_cos_path_prefix
# COS_TEMP_BUCKET_NAME=your_cos_temp_bucket_name
# COS_TEMP_REGION=your_cos_temp_region
# ----- Volcengine TOS (STORAGE_TYPE=tos) -----
# TOS_ENDPOINT=https://tos-cn-beijing.volces.com
# TOS_REGION=cn-beijing
# TOS_ACCESS_KEY=your_tos_access_key
# TOS_SECRET_KEY=your_tos_secret_key
# TOS_BUCKET_NAME=your_tos_bucket_name
# TOS_PATH_PREFIX=your_tos_path_prefix
# TOS_TEMP_BUCKET_NAME=your_tos_temp_bucket_name
# TOS_TEMP_REGION=your_tos_temp_region
# If using AWS S3 as file storage, configure the following parameters
# AWS S3 access endpoint (optional; leave empty to use the Region's standard AWS endpoint, e.g. https://s3.amazonaws.com)
# ----- AWS S3（STORAGE_TYPE=s3）-----
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# AWS S3 access key (optional; if both AK/SK are left empty, the AWS SDK default credential chain is used,
# supports EC2/ECS/EKS IAM Role, IRSA/Web Identity, environment variables, and shared config files)
# AWS S3 secret key (must be filled in together with Access Key, or both left empty)
# S3_SECRET_KEY=your_s3_secret_key
# S3_ACCESS_KEY=your_s3_access_key
# S3_BUCKET_NAME=your_s3_bucket_name
# S3_PATH_PREFIX=weknora/
# S3_USE_SSL=true
# S3_FORCE_PATH_STYLE=false
# ----- Huawei Cloud OBS (STORAGE_TYPE=obs) -----
# OBS_ENDPOINT=obs.cn-north-4.myhuaweicloud.com
# OBS_REGION=cn-north-4
# OBS_ACCESS_KEY=your_obs_access_key
# OBS_SECRET_KEY=your_obs_secret_key
# OBS_BUCKET_NAME=your_obs_bucket_name
# OBS_PATH_PREFIX=weknora/
# OBS_USE_SSL=true
# OBS_PROXY_DOMAIN=https://your-domain.com/obs
# ----- Alibaba Cloud OSS (STORAGE_TYPE=oss) -----
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_REGION=cn-hangzhou
# OSS_ACCESS_KEY=your_oss_access_key
# OSS_SECRET_KEY=your_oss_secret_key
# OSS_BUCKET_NAME=your_oss_bucket_name
# OSS_PATH_PREFIX=weknora/
# OSS_TEMP_BUCKET_NAME=your_oss_temp_bucket_name
# OSS_TEMP_REGION=your_oss_temp_region


# #####################################################################
# C. Retrieval and Graph
# #####################################################################

# ========== C1. Vector Store / Retrieval Engine ==========
# Vector store type (comma-separated, multiple drivers supported): postgres / elasticsearch_v7 / elasticsearch_v8 /
# opensearch / qdrant / milvus / weaviate / doris / tencent_vectordb。
RETRIEVE_DRIVER=postgres
# Timeout for parallel multi-vector-store retrieval (seconds; applies when RETRIEVE_DRIVER lists multiple drivers).
# MULTI_STORE_RETRIEVE_TIMEOUT_SEC=
# ----- Elasticsearch v7/v8 -----
# ELASTICSEARCH_ADDR=http://localhost:9200
# ELASTICSEARCH_USERNAME=your_elasticsearch_username
# ELASTICSEARCH_PASSWORD=your_elasticsearch_password
# ELASTICSEARCH_INDEX=WeKnora
# ----- OpenSearch (single-node profile bundled with the dev compose) -----
# OPENSEARCH_ADDR=http://opensearch:9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_INSECURE_SKIP_VERIFY=false
# OPENSEARCH_INDEX=WeKnora
# ----- Qdrant -----
# QDRANT_HOST=qdrant
# QDRANT_PORT=6334
# QDRANT_REST_PORT=6333
# QDRANT_COLLECTION=weknora_embeddings
# QDRANT_API_KEY=your_qdrant_api_key
# QDRANT_USE_TLS=false
# ----- Milvus -----
# MILVUS_ADDRESS=milvus:19530
# MILVUS_COLLECTION=weknora_embeddings
# MILVUS_METRIC_TYPE=IP          # IP(default)/COSINE/L2, rebuild the collection after changing.
# MILVUS_USERNAME=your_milvus_username
# MILVUS_PASSWORD=your_milvus_password
# MILVUS_DB_NAME=your_milvus_db_name
# ----- Weaviate -----
# Access from inside containers via service:port (do not use localhost/host-mapped ports).
# WEAVIATE_HOST=weaviate:8080
# WEAVIATE_GRPC_ADDRESS=weaviate:50051
# WEAVIATE_SCHEME=http
# WEAVIATE_AUTH_ENABLED=false    # set to true when enabling APIKey/OIDC, and configure WEAVIATE_API_KEY.
# WEAVIATE_API_KEY=your_secret_key
# WEAVIATE_COLLECTION=your_weaviate_db_name
# ----- Apache Doris 4.1+ -----
# DORIS_ADDR=doris-fe:9030       # FE MySQL protocol address.
# DORIS_HTTP_PORT=8030           # FE HTTP, Stream Load partial update endpoint.
# DORIS_DATABASE=weknora
# DORIS_USERNAME=root
# DORIS_PASSWORD=
# DORIS_TABLE_PREFIX=weknora_embeddings
# DORIS_COMPAT_MODE=auto         # auto(detect)/legacy(cosine_distance)/inner_product_duplicate; cannot be switched after table creation.
# compose port.
# DORIS_FE_HTTP_PORT=8030
# DORIS_FE_MYSQL_PORT=9030
# DORIS_BE_HTTP_PORT=8040
# ----- Tencent Cloud VectorDB -----
# TENCENT_VECTORDB_ADDR=http://your-instance.tencentvectordb.com
# TENCENT_VECTORDB_USERNAME=root
# TENCENT_VECTORDB_API_KEY=your_tencent_vectordb_api_key
# TENCENT_VECTORDB_DATABASE=weknora
# TENCENT_VECTORDB_COLLECTION=weknora_embeddings
# TENCENT_VECTORDB_REPLICA_NUMBER=1

# ========== C2. Knowledge Graph (Neo4j, optional) ==========
# Global master switch for the knowledge graph. If not true, graph building and retrieval are disabled (the build phase calls an LLM and takes a while).
# Note: ENABLE_GRAPH_RAG has been superseded by NEO4J_ENABLE since v0.1.6; the Go main app no longer reads it, and it has been removed.
# NEO4J_ENABLE=false
# Neo4j connection URI. bolt:// connects directly to a single node (recommended, no routing overhead); neo4j:// uses cluster routing discovery (works for single-node too, but adds one extra probe).
# WeKnora deploys a single-node Neo4j by default, so use bolt://.
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password


# #####################################################################
# D. Models
# #####################################################################

# ========== D1. LLM / VLM / Ollama ==========
# Only warn (not block) when Ollama is unavailable (applies when true; default does not block, to avoid startup failure when Ollama isn't configured).
OLLAMA_OPTIONAL=true
# Ollama service base URL (connects to local/remote Ollama).
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Batch embedding size (leave blank to use the code default).
# BATCH_EMBED_SIZE=
# VLM single HTTP request timeout (seconds, default 180; increase if a slow endpoint reports a context deadline exceeded).
# VLM_HTTP_TIMEOUT_SECONDS=180
# Raw LLM stream dump (for troubleshooting context issues; 1 to enable, default directory ~/.weknora/investigate/llm-stream).
# WEKNORA_LLM_STREAM_RAW_DUMP=
# WEKNORA_LLM_STREAM_RAW_DUMP_DIR=

# ========== D2. Built-in Model Declarative Config (optional) ==========
# After enabling config/builtin_models.yaml (see config/builtin_models.yaml.example), the
# ${NAME} placeholders in the YAML are resolved to real values from here at app startup. Variable names are user-defined in the YAML; common naming references are given below.
# See docs/BUILTIN_MODELS.md for details.
#
# Built-in chat model
# LLM_MODEL_NAME=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_PROVIDER=openai
#
# Built-in embedding model
# EMBEDDING_MODEL_NAME=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_PROVIDER=openai
#
# Built-in rerank model
# RERANK_MODEL_NAME=
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_PROVIDER=generic


# #####################################################################
# E. Document Parsing
# #####################################################################

# ========== E1. Docreader gRPC and Parsing Common Settings ==========
# ----- gRPC server TLS / auth (shared by docreader and app, client/server must use matching values) -----
# Enable gRPC TLS encrypted transport. Default false (docreader is only called by app within the compose internal network, plaintext is fine).
# GRPC_TLS_ENABLED=false
# Server certificate / client certificate (required for mTLS). Required when server has TLS enabled.
# GRPC_TLS_CERT=/path/to/server.crt
# Private key for the certificate.
# GRPC_TLS_KEY=/path/to/server.key
# CA certificate: used by the client to verify the server certificate; used by the server to issue client certificates when mTLS is enabled.
# GRPC_TLS_CA=/path/to/ca.crt
# TLS SNI / certificate verification name. Set to the hostname in the certificate when DOCREADER_ADDR uses an IP or doesn't match the certificate's CN.
# GRPC_TLS_SERVER_NAME=
# Server side: when true, requires the client to present a certificate (mutual TLS / mTLS).
# GRPC_MTLS_REQUIRE_CLIENT_CERT=false
# gRPC per-RPC auth token (client and server must match). When enabled, TLS is strongly recommended,
# otherwise the token is sent in plaintext with every RPC; when GRPC_TLS_ENABLED=true, the client will refuse to send the token over an insecure connection.
# GRPC_AUTH_TOKEN=your-secret-token-at-least-16-bytes
# ----- gRPC service parameters -----
# Max concurrent workers for the gRPC server (default 4).
# DOCREADER_GRPC_MAX_WORKERS=4
# Max size per gRPC message (MB, default 50). Usually follows MAX_FILE_SIZE_MB; oversized scanned-document images may exceed this value.
# DOCREADER_GRPC_MAX_FILE_SIZE_MB=50
# gRPC listening port (default 50051) usually doesn't need changes; must match the docreader port in docker-compose.
# DOCREADER_GRPC_PORT=50051
# ----- General parsing -----
# Max pages for DOCX parsing (default 0 = unlimited). Set a positive integer (e.g. 500) to cap parsing cost for oversized Word documents.
# DOCREADER_DOCX_MAX_PAGES=0
# Number of concurrent workers for MarkItDown (heavy parser). 0 disables throttling; default 1 suits single-machine/GPU-constrained setups.
# DOCREADER_MARKITDOWN_MAX_WORKERS=1
# Outbound HTTP/HTTPS proxy (used for web scraping / remote images).
# DOCREADER_EXTERNAL_HTTP_PROXY=
# DOCREADER_EXTERNAL_HTTPS_PROXY=

# ========== E2. OpenDataLoader hybrid (optional, specified via knowledge base parser_engine_rules with engine: opendataloader) ==========
# Concurrent workers for the ODL heavy parser (default 1).
# DOCREADER_ODL_MAX_WORKERS=1
# Hybrid mode switch: off (default, pure fast local parsing) / docling-fast, etc. (requires a separate odl-hybrid container).
# DOCREADER_ODL_HYBRID=off
# odl-hybrid service address. Code default is http://127.0.0.1:5002; docker compose injects http://odl-hybrid:5002.
# DOCREADER_ODL_HYBRID_URL=http://odl-hybrid:5002
# Hybrid mode selection (auto), usually no change needed.
# DOCREADER_ODL_HYBRID_MODE=auto
# Whether to fall back to fast mode when hybrid fails (default false).
# DOCREADER_ODL_HYBRID_FALLBACK=false
# Whether hybrid output markdown retains HTML (default false).
# DOCREADER_ODL_MARKDOWN_WITH_HTML=false
# ----- odl-hybrid container parameters (only used with --profile odl-hybrid) -----
# Extra arguments passed to odl-hybrid. Default --no-ocr (digital PDFs); use --force-ocr for scanned documents (requires EasyOCR+libGL).
# ODL_HYBRID_EXTRA_ARGS=--no-ocr
# odl-hybrid external port (for dev compose mapping).
# ODL_HYBRID_PORT=5002
# Max wait time (seconds) for odl-hybrid readiness at app startup.
# ODL_HYBRID_STARTUP_WAIT_SEC=180

# ========== E3. PDF rendering ==========
# Number of PDF rendering workers (cross-document concurrency, default 1).
# DOCREADER_PDF_RENDER_MAX_WORKERS=1
# Number of parallel processes for "scanned page rendering" within a single PDF (pdfium is not thread-safe, so parallelism is process-based). Defaults to min(4, cpu) based on CPU count; serial rendering of large scanned documents can take hours on CPU-constrained containers — increasing this can significantly reduce that time (measured: 874 pages 117s -> 30s with 4 processes -> 17s with 8 processes). The container needs enough allocated CPU to benefit from the speedup.
# DOCREADER_PDF_RENDER_PARALLELISM=4
# Rendering DPI (default 200).
# DOCREADER_PDF_RENDER_DPI=200
# Rendered image JPEG quality (default 85).
# DOCREADER_PDF_JPEG_QUALITY=85
# Max long-edge pixel size for rendered page images (default 2000). Prevents oversized pages from rendering into 100+MP images that exceed the gRPC message size limit; lowering it further reduces image size, but too small will hurt OCR accuracy (for dense Chinese text, >=1600 recommended).
# DOCREADER_PDF_RENDER_MAX_EDGE=2000

# ========== E4. PDF scanned-document detection and forcing ==========
# Force all PDF pages to be parsed as scanned documents (rendered to images then processed via OCR/VLM). Suitable for PDFs with poor-quality text layers but OCR-able pages; enabling this increases both processing time and model call costs. Default false (auto-determined by the threshold below).
# DOCREADER_PDF_FORCE_SCANNED=false
# Auto-detection: a page is considered scanned if its image object coverage area is >= this ratio (default 0.5).
# DOCREADER_PDF_SCAN_IMAGE_RATIO=0.5
# Auto-detection: a page is considered to have "no usable text layer" if its character count is below this value (default 10).
# DOCREADER_PDF_SCAN_MIN_CHARS=10

# ========== E5. PDF layout / text extraction (native text pages) ==========
# Layout-aware text extraction: reconstructs readable reading order (default true).
# DOCREADER_PDF_LAYOUT_ORDERING=true
# When glyphs lack explicit space positioning (common in OCR/searchable text), insert a space when spacing exceeds this multiple of the median glyph width (default 0.4).
# DOCREADER_PDF_WORD_GAP_WIDTH_RATIO=0.4
# Page-width ratio threshold for discarding narrow side columns (e.g. arXiv sidebar watermarks, page-number labels) (default 0.12).
# DOCREADER_PDF_MARGIN_COL_WIDTH_RATIO=0.12
# Minimum characters a line must have before the font-size heuristic can promote it to a markdown heading (default 8).
# DOCREADER_PDF_MIN_HEADING_LINE_CHARS=8
# Promote visually larger lines to markdown headings (uses rect height as a font-size proxy, default true).
# DOCREADER_PDF_DETECT_HEADINGS=true
# Discard invisible text (render-mode 3), off-page text, and degenerate text to prevent hidden-text injection (default true).
# DOCREADER_PDF_FILTER_HIDDEN_TEXT=true
# Clean up pdfium placeholders (U+FFFE) and soft hyphens; strip vector-graphic axis/legend text (default true).
# DOCREADER_PDF_SANITIZE_TEXT=true
# Strip fragment text from chart regions (works together with SANITIZE_TEXT, default true).
# DOCREADER_PDF_STRIP_CHART_DEBRIS=true

# ========== E6. PDF embedded image extraction (native text pages) ==========
# Extract embedded bitmaps from native pages for VLM/OCR analysis (default true).
# DOCREADER_PDF_EXTRACT_EMBEDDED_IMAGES=true
# Minimum pixel width and height for embedded images to be kept (default 80; images below this are discarded).
# DOCREADER_PDF_EMBED_MIN_PIXELS=80
# Minimum ratio of embedded image area to page area, below which the image is discarded (default 0.01).
# DOCREADER_PDF_EMBED_MIN_AREA_RATIO=0.01
# When the same image appears in text pages at or above this ratio, it is treated as a running header/footer element and deduplicated (default 0.5).
# DOCREADER_PDF_EMBED_REPEAT_PAGE_FRAC=0.5
# Hard cap on embedded images extracted per document (default 50).
# DOCREADER_PDF_EMBED_MAX_IMAGES=50

# ========== E7. PDF chart region detection (vector graphic regions) ==========
# Render detected vector chart regions (no embedded bitmap) to JPEG for VLM/OCR (default true).
# DOCREADER_PDF_RENDER_VECTOR_FIGURES=true
# Minimum characters per line required for a region to be considered a chart (default 18).
# DOCREADER_PDF_MIN_CHART_REGION_CHARS=18
# Minimum area ratio required for a region to be considered a chart (default 0.015).
# DOCREADER_PDF_MIN_CHART_REGION_AREA=0.015
# Maximum area ratio for a region to be considered a chart (above this it's not treated as a chart, default 0.42).
# DOCREADER_PDF_MAX_CHART_REGION_AREA=0.42
# Maximum ratio of graphic height to page height; above this it's not treated as a standalone chart (default 0.38).
# DOCREADER_PDF_MAX_FIGURE_HEIGHT_RATIO=0.38

# ========== E8. Document processing / task timeouts ==========
# Total timeout for a single document processing task (Go duration, default 2h; increase for large files).
# WEKNORA_DOCUMENT_PROCESS_TIMEOUT=2h
# Timeout for a single DocReader RPC call (default 30m, must be less than the item above).
# WEKNORA_DOCREADER_CALL_TIMEOUT=30m
# Knowledge base inspection recovery (reclaims dirty data stuck in processing; false disables it, not recommended).
# WEKNORA_HOUSEKEEPING_ENABLED=true
# Retention period for chat attachment parsing artifacts (hours, default 24).
# WEKNORA_CHAT_ATTACHMENT_TTL_HOURS=24
# Maximum wait time for attachment parsing to complete within a single Q&A turn (seconds, default 60; increase for large/scanned files).
# WEKNORA_CHAT_ATTACHMENT_WAIT_TIMEOUT_SEC=60
# Attachment VLM OCR tuning (for scanned/image-based documents): concurrency / max pages.
# WEKNORA_CHAT_ATTACHMENT_OCR_CONCURRENCY=8
# WEKNORA_CHAT_ATTACHMENT_OCR_MAX_PAGES=8

# ========== E9. Feishu cloud document parsing mode ==========
# Controls the parsing path used when syncing new-format cloud documents (docx) from Feishu Drive / Feishu Wiki:
# export (default, leave blank): downloads the .docx binary via the async export API and hands it to docreader
# for parsing. Images are inlined into the parent document (parent_chunk_id linked to knowledge), so retrieval /
# wiki / agent scenarios can all associate the image content. Trade-off: sync is slower; file block attachments
# inside the Feishu docx are not downloaded with the export (they are lost and must be synced separately); if the
# cloud document contains spreadsheets, multi-dimensional tables, etc., after export they become tables embedded
# in the docx, which WeKnora cannot parse.
# blocks: converts via the blocks API to Markdown. Fast, keeps attachments inside the docx; but images render as empty
# `![image]()` placeholders and are ingested as separate knowledge entries with no content link to the parent
# document (retrieval / wiki / agent scenarios cannot associate the images back to the document); spreadsheets are
# parsed into Markdown tables, with a risk of losing merged-cell styling and similar formatting.
# Set to blocks when you don't need image association, want speed, need to keep attachments, or need to preserve spreadsheet styling.
# FEISHU_DOCX_PARSE_MODE=export

# #####################################################################
# This is a temporary solution; once a better parsing approach is available, this environment variable will be removed and replaced.
# #####################################################################

# F. Authentication and tenant isolation
# ========== F1. Secrets ⚠️ Required (must be changed from defaults in production) ==========
JWT_SECRET=weknora-jwt-secret
# JWT signing key, used for frontend login token refresh (leave blank to generate randomly at startup).
# AES-256 master key, used to encrypt sensitive fields such as API keys at rest in the database (must be 32 bytes).
# Encryption scope: tenants.api_key, model API keys, vector store credentials, web search provider keys,
# WeKnoraCloud.AppSecret, etc. If missing or the wrong length, already-encrypted fields cannot be decrypted (shown blank in the UI and must be re-entered).
# Must be explicitly set and safely kept in production; if lost, all encrypted data is unrecoverable.
SYSTEM_AES_KEY=weknora-system-aes-key-32bytes!!

# Note: TENANT_AES_KEY / CRYPTO_MASTER_KEY / CRYPTO_SALT are deprecated. As of v0.4.0, CryptoService (PBKDF2) has been removed and encryption now uses SYSTEM_AES_KEY exclusively. These three variables are no longer read by the Go main application and have been removed.
# Disable new user registration (recommended true in production).
# DISABLE_REGISTRATION=false
# Default space policy after public registration: create_personal (default, auto-creates a personal space) / tenantless.
# WEKNORA_AUTH_DEFAULT_TENANT_MODE=create_personal
# Whether regular users can create spaces on their own after logging in (default true; false means invite-only, super admins unaffected).
# WEKNORA_TENANT_SELF_SERVICE_CREATION_ENABLED=true
# Enable space-level RBAC (true default enforces authorization / false observation mode only logs, does not block).
# WEKNORA_TENANT_ENABLE_RBAC=true
# Enable cross-space access (requires the user's CanAccessAllTenants permission; default false). For cross-space admins, you must manually edit the database to grant cross-space admin permission to the relevant user.
# WEKNORA_TENANT_ENABLE_CROSS_TENANT_ACCESS=false
# Max number of spaces a non-super-admin user can self-create (>0 enforces a limit; =0 uses default; <0 disables the limit).
# WEKNORA_TENANT_MAX_OWNED_PER_USER=
# Whether to auto-generate a full_access API Key and return the token in the response when creating a space (default false, legacy fallback switch).
# WEKNORA_TENANT_AUTO_CREATE_API_KEY=false
# Default storage quota for new spaces (GB, default 10).
# WEKNORA_TENANT_DEFAULT_STORAGE_QUOTA_GB=10
# Space invitation link TTL (Go duration, default 168h = 7 days).
# WEKNORA_INVITATION_TTL=168h
# Audit log retention in days (0 disables cleanup, default 90).
# WEKNORA_AUDIT_RETENTION_DAYS=90

# ========== F3. OIDC Authentication (optional, enable with OIDC_AUTH_ENABLE=true) ==========
# OIDC_AUTH_ENABLE=false
# OIDC_AUTH_ISSUER_URL=http://127.0.0.1:5556/dex
# OIDC_AUTH_DISCOVERY_URL=http://127.0.0.1:5556/dex/.well-known/openid-configuration
# OIDC_AUTH_PROVIDER_DISPLAY_NAME=OIDC
# OIDC_AUTH_CLIENT_ID=client_id_for_oidc_client
# OIDC_AUTH_CLIENT_SECRET=secret_for_oidc_client
# If OIDC_AUTH_DISCOVERY_URL is set, the following endpoints can be left blank.
# OIDC_AUTH_AUTHORIZATION_ENDPOINT=http://127.0.0.1:5556/dex/auth
# OIDC_AUTH_TOKEN_ENDPOINT=http://127.0.0.1:5556/dex/token
# OIDC_AUTH_USER_INFO_ENDPOINT=http://127.0.0.1:5556/dex/userinfo
# OIDC_AUTH_SCOPES="openid profile email"
# The space policy after OIDC first-time auto account creation shares WEKNORA_AUTH_DEFAULT_TENANT_MODE with local registration; there is no separate config.
# OIDC_USER_INFO_MAPPING_USER_NAME=name
# OIDC_USER_INFO_MAPPING_EMAIL=email


# #####################################################################
# G. Agent and Sandbox
# #####################################################################

# ========== G1. Agent Skills Sandbox ==========
# Sandbox mode: docker (default) / local / disabled.
WEKNORA_SANDBOX_MODE=docker
# Script execution timeout (seconds, default 60).
WEKNORA_SANDBOX_TIMEOUT=60
# Sandbox Docker image (default wechatopenai/weknora-sandbox:latest).
# WEKNORA_SANDBOX_DOCKER_IMAGE=wechatopenai/weknora-sandbox:latest
# Custom Skills directory (specify after mounting, no image rebuild needed).
# WEKNORA_SKILLS_DIR=
# Default timeout for agent LLM calls (seconds, default 120; increase for complex reasoning, e.g. 300/600).
# Note: global default; if an agent has its own llm_call_timeout set in the database, that takes precedence.
# WEKNORA_AGENT_LLM_TIMEOUT=300
# MCP tool manual review wait timeout (seconds, default 600; supports Go duration like 30s/5m/1h).
# WEKNORA_AGENT_TOOL_APPROVAL_TIMEOUT=600
# Whether to allow the action through when MCP tool manual approval fails (true allows / default fail-close denies).
# WEKNORA_AGENT_TOOL_APPROVAL_FAIL_OPEN=


# #####################################################################
# H. Optional Integrations
# #####################################################################

# ========== H1. Web Search (SearXNG / Tavily) ==========
# ===== SearXNG (optional self-hosted web search) =====
# Enable: `docker compose --profile searxng up -d`.
# When SEARXNG_SECRET is not set, the hardcoded default in docker-compose is used, which is sufficient for local/loopback deployment;
# If you change SEARXNG_BIND=0.0.0.0 to expose the instance to the LAN/public internet, be sure to generate one with openssl rand -hex 32
# and explicitly set SEARXNG_SECRET, otherwise the default value can be used by anyone to sign image-proxy URLs.
#
# Backend access method (containerized deployment): in the console, select "SearXNG" as the Provider type,
# set Instance URL to http://searxng:8080; docker compose already injects the searxng hostname by default into
# SSRF_WHITELIST_EXTRA, no extra configuration needed.
#
# Local development (go run + docker compose -f docker-compose.dev.yml --profile searxng up):
# the backend runs on the host machine and must go through the published port; set Instance URL to http://127.0.0.1:8888,
# and add 127.0.0.1 to the SSRF_WHITELIST below.
#
# The port only listens on 127.0.0.1 by default, to avoid exposing an instance with limiter:false to the LAN.
# To open it to the internal network, explicitly override SEARXNG_BIND=0.0.0.0 and harden it yourself.
# SEARXNG_PORT=8888
# SEARXNG_BIND=127.0.0.1
# SEARXNG_SECRET=
# Tavily Search API Key (optional, enables the Tavily web search provider).
# TAVILY_API_KEY=tvly-your_tavily_api_key

# ========== H2. MCP Server (optional, starts with --profile full) ==========
# API Key the MCP Server uses to access the WeKnora REST API (generate it in the frontend under "Settings -> API Keys").
# WEKNORA_API_KEY=
# Required for HTTP/SSE transport: mcp-server will refuse to start if this is missing (clients pass it as Authorization: Bearer).
# MCP_SERVER_AUTH_TOKEN=
# Read timeout (seconds, default 300) for calling the WeKnora REST API.
# WEKNORA_CHAT_TIMEOUT=300
# Whether to verify the WeKnora backend TLS certificate (default true; set false for self-signed certificates).
# WEKNORA_VERIFY_SSL=true
# Whitelist of directories allowed for uploads (comma-separated; leave empty to disable the file upload tool).
# MCP_ALLOWED_UPLOAD_DIRS=


# #####################################################################
# I. Observability (Langfuse, optional)
# #####################################################################

# ========== I1. Langfuse integration (traces chat/embedding/rerank/VLM/ASR model calls, tracks token usage) ==========
# Details: docs/Langfuse集成.md
#
# Option A: Connect to Langfuse Cloud (simplest)
# 1) Log in to https://cloud.langfuse.com and generate an API key
# 2) Fill in PUBLIC_KEY / SECRET_KEY below
#   3) docker compose up -d app
#
# Option B: Self-hosted Langfuse (LAN/intranet environment)
# 1) Start the self-hosted stack: docker compose --profile langfuse up -d
# On first startup, ClickHouse migration takes about 1-2 minutes; wait for langfuse-web to become healthy
# 2) Open http://localhost:3000 in a browser, register an admin account, and generate an API key
# 3) Uncomment LANGFUSE_HOST=http://langfuse-web:3000 below, and fill in the PUBLIC_KEY / SECRET_KEY you just generated
#   4) docker compose up -d app
#
# It's enabled automatically as long as both PUBLIC_KEY and SECRET_KEY are set — no explicit toggle needed.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=http://langfuse-web:3000
# For self-hosted mode, change to: LANGFUSE_HOST=http://langfuse-web:3000
# Optional: explicit toggle (true/false, default inferred from the keys).
# LANGFUSE_ENABLED=true
# Optional: version / environment tags, for filtering in the Langfuse UI.
# LANGFUSE_RELEASE=v0.4.2
# LANGFUSE_ENVIRONMENT=production
# Optional: batch reporting and sampling strategy (for high production traffic, consider increasing FLUSH_AT and lowering SAMPLE_RATE).
# LANGFUSE_FLUSH_AT=15
# LANGFUSE_FLUSH_INTERVAL=3s
# LANGFUSE_QUEUE_SIZE=2048
# LANGFUSE_REQUEST_TIMEOUT=10s
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_DEBUG=false

# ========== I2. Langfuse self-hosted stack configuration (only needed when using --profile langfuse) ==========
# Design note: to minimize resource usage, the self-hosted Langfuse stack **reuses** WeKnora's existing
# - postgres: creates a separate "langfuse" database (created once by the langfuse-db-init container)
# - redis: uses a separate Redis DB number (default 1; WeKnora uses 0)
# Only 3 new persistent containers are actually added: langfuse-web, langfuse-worker, langfuse-clickhouse
# + 1 dedicated S3: langfuse-minio
# + 1 one-off init: langfuse-db-init
# External port for the Langfuse Web UI.
# LANGFUSE_WEB_PORT=3000
# Dedicated MinIO port for Langfuse (to avoid conflicting with WeKnora's main MinIO on 9000/9001).
# LANGFUSE_MINIO_S3_PORT=9100
# LANGFUSE_MINIO_CONSOLE_PORT=9101
# External endpoint for media uploads (browser connects directly to Langfuse MinIO), defaults to the host-mapped port 9100.
# LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9100
# Name of the Langfuse database created in WeKnora-postgres.
# LANGFUSE_DB_NAME=langfuse
# Redis DB number used in WeKnora-redis (1-15; don't conflict with WeKnora's 0).
# LANGFUSE_REDIS_DB=1
# ClickHouse / Langfuse-dedicated MinIO credentials (be sure to change these in production).
# LANGFUSE_CLICKHOUSE_USER=clickhouse
# LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
# LANGFUSE_MINIO_USER=langfuseminio
# LANGFUSE_MINIO_PASSWORD=langfuseminiosecret
# Langfuse core security fields — must be regenerated for production:
#   LANGFUSE_SALT=$(openssl rand -base64 32)
#   LANGFUSE_ENCRYPTION_KEY=$(openssl rand -hex 32)
#   LANGFUSE_NEXTAUTH_SECRET=$(openssl rand -base64 32)
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_NEXTAUTH_URL=http://localhost:3000
# LANGFUSE_TELEMETRY_ENABLED=false
# Optional: automate first startup (once filled in, injects admin + project directly, skipping UI registration).
# LANGFUSE_INIT_ORG_ID=WeKnora
# LANGFUSE_INIT_ORG_NAME=WeKnora
# LANGFUSE_INIT_PROJECT_ID=WeKnora
# LANGFUSE_INIT_PROJECT_NAME=WeKnora
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-weknora-init
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-weknora-init
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_NAME=Admin
# LANGFUSE_INIT_USER_PASSWORD=change-me-please


# #####################################################################
# J. Security and deployment tuning
# #####################################################################

# ========== J1. SSRF protection ==========
# SSRF validation whitelist (optional). Comma-separated; each entry can be: an exact domain (api.internal), a wildcard domain (*.example.com),
# IPv4 (203.0.113.5), IPv6 (2001:db8::1, without brackets), or CIDR (10.0.0.0/8, 2001:db8::/32).
# Entries in this list bypass normal SSRF rules in URL validation and elsewhere — configure with caution in production.
# SSRF_WHITELIST=internal.service,*.corp.example,172.16.0.0/12,2001:db8::1,fd00::/8
#
# ===== SSRF validation for vector store addresses =====
# When creating/testing vector store connections via the API, addresses go through SSRF validation. Built-in docker-compose services
# (qdrant, milvus, weaviate, doris-fe, doris-be, searxng) are allowed by default via SSRF_WHITELIST_EXTRA.
# If using external private-network addresses or blocked ports (5432, 9200, etc.), add the host to SSRF_WHITELIST_EXTRA
# (note: overriding this variable replaces the compose defaults, so you must re-include the built-in service names), for example:
#   SSRF_WHITELIST_EXTRA=searxng,qdrant,milvus,weaviate,doris-fe,doris-be,my-opensearch.internal
#
# Doris Stream Load: FE 307-redirects the request to BE; docker compose allows
# doris-fe and doris-be by default (see SSRF_WHITELIST_EXTRA).
#
# Local development (go run + docker-compose.dev.yml --profile opensearch): the backend runs on the host,
# OpenSearch is accessed via the published port http://localhost:9200; before creating this vector store via the API,
# add localhost to SSRF_WHITELIST (9200 is a blocked port, localhost is a restricted hostname):
#   SSRF_WHITELIST=localhost
# Image domain whitelist for preserving original URLs (optional, comma-separated). When set, images from these domains are still downloaded and analyzed
# (OCR/captioning), but the original URL is kept in the markdown instead of being replaced with a provider:// object storage URL.
# IMAGE_HOST_KEEP_URL=mineru.internal.example.com

# ========== J2. Proxy & Concurrency ==========
# CIDRs trusted by gin as proxies (comma-separated). Trusts loopback + private ranges by default (already covered by nginx inside the container network).
# Setting this explicitly to an empty string disables proxy trust (ClientIP returns the direct peer). Production deployments behind multiple proxy layers should set this to match the actual setup.
# WEKNORA_TRUSTED_PROXIES=
# ants goroutine pool size (Embedding concurrency; lower it if you see 429s).
CONCURRENCY_POOL_SIZE=5
