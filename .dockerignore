# VCS / CI
.git/
.github/
.gitignore
.gitattributes

# Editor / IDE local config
.cursor/
.claude/
.codebuddy/
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Python virtual environments / cache
**/.venv/
.venv_proto/
**/.python-version
**/__pycache__/
**/*.pyc

# Node / Frontend
# Note: the context used by build-ui is ./frontend, so the root .dockerignore doesn't apply to it,
# and the Dockerfiles for the other images (app/docreader/sandbox) don't reference frontend/,
# so it's safe to exclude the entire frontend/ directory here.
**/node_modules/
frontend/
WeKnora-Chrome-Extension/

# Logs / temp files
logs/
tmp/
temp/
*.log
*.pid

# Local build artifacts / binaries
WeKnora
WeKnora-lite
/server
/dist/
/build/
/artifacts/browserskill/
cmd/desktop/build/bin/

# Local data / model files
/models/
data/files/
data/*.db
data/*.db-wal
data/*.db-shm
test/data/mswag.txt

# Sensitive files
.env
.env.lite
*.pem
*.key
*.crt
*_key
*_secret

# Large archives/compressed files
packages/protoc-*.zip
!packages/protoc-*-linux-x86_64.zip
!packages/protoc-*-linux-aarch_64.zip
!packages/protoc-*-linux-arm.zip

# Local test scripts
configure-ollama.sh
fix-docker.sh
/scripts/scale_dev_jobs.sh

# Note: do not exclude docs/ — docs.go / swagger.json inside it are swagger packages that Go code depends on
# Note: do not use a *.md wildcard to exclude — skills/preloaded/**/SKILL.md gets bundled into the image for the agent to use
