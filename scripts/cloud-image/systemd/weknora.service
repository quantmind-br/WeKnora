[Unit]
Description=WeKnora (docker compose)
Requires=docker.service weknora-firstboot.service
After=docker.service network-online.target weknora-firstboot.service
Wants=network-online.target
# Key: Requires=weknora-firstboot.service makes this service also not start when first-boot init fails,
# preventing postgres data volume initialization with the .env.example default plaintext password
# before firstboot successfully generates random secret keys. weknora-firstboot.service is skipped
# on already-initialized instances via ConditionPathExists=!/opt/WeKnora/.firstboot.done — skip = success,
# and it does not block subsequent restarts of this service.

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/WeKnora
ExecStart=@DOCKER_BIN@ compose up -d
ExecStop=@DOCKER_BIN@ compose down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
