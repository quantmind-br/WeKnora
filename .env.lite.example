# WeKnora Lite Configuration Template
# Copy this file to .env.lite and edit as needed
#   cp .env.lite.example .env.lite

GIN_MODE=debug

# Log level. Options: debug, info, warn, error, fatal
LOG_LEVEL=debug

# Optional: absolute path to the log file; if not set, the macOS .app defaults to
# ~/Library/Logs/WeKnora Lite/WeKnora Lite.log
# LOG_PATH=/absolute/path/to/weknora-lite.log

# === Database ===
# In the macOS .app, relative paths are automatically redirected to
# ~/Library/Application Support/WeKnora Lite/data/
DB_DRIVER=sqlite
DB_PATH=./data/weknora.db

# === Retrieval engine (FTS5 + sqlite-vec) ===
RETRIEVE_DRIVER=sqlite

# === File storage ===
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=./data/files

# === Stream manager (in-memory, no Redis) ===
STREAM_MANAGER_TYPE=memory

# === LLM service ===
# Local Ollama service (default address, edit as needed).
# Embedding models with source=local share this address with chat models, so there is no need to start a separate Ollama for embeddings.
# The embedding model name is set in the model configuration (e.g. nomic-embed-text), not as a separate environment variable.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# To use another OpenAI-compatible service, uncomment:
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# === Security settings (make sure to change these in production!) ===
# Native desktop generates and persists its signing key automatically.
# For encrypted credential storage, generate once: openssl rand -hex 16
SYSTEM_AES_KEY=
JWT_SECRET=

# === Feature toggles ===
NEO4J_ENABLE=false
WEKNORA_SANDBOX_MODE=disabled
ENABLE_GRAPH_RAG=false
DISABLE_REGISTRATION=false
# Image domain whitelist for keeping original URLs (optional)
# IMAGE_HOST_KEEP_URL=mineru.internal.example.com

# === Langfuse observability (optional) ===
# Traces prompts, responses, and token usage for chat / embedding / rerank / VLM / ASR.
# Automatically enabled once both PUBLIC_KEY and SECRET_KEY are set; see website-docs/03-features/16-observability.md.
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# === Performance ===
CONCURRENCY_POOL_SIZE=3

# How long (in hours) chat attachment parsing artifacts are retained; defaults to 24 hours
# WEKNORA_CHAT_ATTACHMENT_TTL_HOURS=24

# Maximum time (in seconds) a single Q&A turn waits for attachment parsing to finish; attachments
# not done by then are skipped. Increase for large files / slow scanned-document parsing; defaults
# to 60 seconds. The agent's "attachment parsing wait timeout" setting, when > 0, takes precedence
# over this global value.
# WEKNORA_CHAT_ATTACHMENT_WAIT_TIMEOUT_SEC=60

# Attachment VLM OCR tuning (scanned / image-based documents). The bottleneck for slow parsing is
# per-page VLM OCR, not the document parser. OCR_CONCURRENCY is the number of pages OCR'd in
# parallel (default 8, matching the page cap, so scanned documents finish in one pass; raising it
# increases load on the VLM backend, which all agents share, so it stays global); OCR_MAX_PAGES is
# the maximum number of scanned-document pages sent to the VLM (default 8). The agent's "max OCR
# pages for scanned documents" setting, when > 0, takes precedence over this global value.
# WEKNORA_CHAT_ATTACHMENT_OCR_CONCURRENCY=8
# WEKNORA_CHAT_ATTACHMENT_OCR_MAX_PAGES=8

# Docreader address
DOCREADER_ADDR=127.0.0.1:50051

# Docreader transport
DOCREADER_TRANSPORT=grpc

# gRPC TLS settings (optional)
# GRPC_TLS_ENABLED=false
# GRPC_TLS_CERT=/path/to/server.crt           # server: required; client: required for mTLS
# GRPC_TLS_KEY=/path/to/server.key            # same as above
# GRPC_TLS_CA=/path/to/ca.crt                 # client: used to verify the server certificate; server: CA that issues client certs for mTLS
# GRPC_TLS_SERVER_NAME=                       # optional; set to the certificate's hostname when DOCREADER_ADDR uses an IP or doesn't match the cert CN
# GRPC_MTLS_REQUIRE_CLIENT_CERT=false         # server side: when true, requires a client certificate (mTLS)

# gRPC auth token (optional; client and server must use the same value)
# Note: if GRPC_AUTH_TOKEN is enabled, TLS should strongly be enabled too, otherwise the token is
# sent in plaintext over the network with every RPC. When GRPC_TLS_ENABLED=true, the client will
# refuse to send the token over an insecure connection.
# GRPC_AUTH_TOKEN=your-secret-token-at-least-16-bytes
